# Copy to .env and adjust as needed.

# SQLite database URL used for the agent's memory store.
ASSISTANT_DATABASE_URL=sqlite:///./assistant.db

# Owner name used to personalise the daily brief.
ASSISTANT_OWNER_NAME=Valdimar

# If true, WRITE actions execute immediately instead of requiring approval.
# Leave false to keep the human-in-the-loop approval model (recommended).
ASSISTANT_AUTO_APPROVE=false
